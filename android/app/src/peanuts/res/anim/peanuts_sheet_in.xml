<?xml version="1.0" encoding="utf-8"?>
<!-- A sheet opens (Motion.ENTER, 180 ms): it fades in and grows from 96 %. Run by the system as a window animation -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@interpolator/peanuts_out" android:shareInterpolator="true">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="180" />
    <scale android:fromXScale="0.96" android:toXScale="1" android:fromYScale="0.96" android:toYScale="1" android:pivotX="50%" android:pivotY="50%" android:duration="180" />
</set>
